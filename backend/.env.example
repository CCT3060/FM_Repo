PORT=4000
ALLOW_ORIGIN=http://localhost:5173,https://your-amplify-domain.amplifyapp.com
DATABASE_URL=postgresql://postgres.qcotfnxeategohbczekl:<url-encoded-password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
DB_SSL=require
SUPABASE_DB_SSL=require
DB_POOL_SIZE=10

# Auth
JWT_SECRET=change_me_to_strong_secret

# ── Scheduled Email Reports (nodemailer) ────────────────────────────────────
# MAIL_PROVIDER: gmail (default) or outlook/office365
MAIL_PROVIDER=gmail
# For Gmail: use an App Password (not your account password)
# Enable 2-Factor Auth → Google Account → Security → App Passwords → Generate
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-password-here
# For Outlook/Office365: use your regular password or an app password
# MAIL_PROVIDER=outlook
# MAIL_USER=your-email@outlook.com
# MAIL_PASS=your-password-here

# Firebase Admin SDK for FCM push notifications
# Option A: path to your downloaded service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/soft-fm-app-firebase-adminsdk-xxxx.json
# Option B: paste the entire JSON content as a single-line string (useful for cloud/env vars)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
