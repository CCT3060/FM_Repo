PORT=4000
ALLOW_ORIGIN=http://localhost:5173,https://your-amplify-domain.amplifyapp.com
DATABASE_URL=postgresql://postgres.qcotfnxeategohbczekl:<url-encoded-password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres
DB_SSL=require
SUPABASE_DB_SSL=require
